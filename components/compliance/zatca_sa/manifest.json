        },
        {
          "type": "function",
          "ref": "components.compliance.zatca_sa.phase1.encode_phase1_tlv"
        },
        {
          "type": "function",
          "ref": "components.compliance.zatca_sa.phase1.decode_phase1_tlv"
        },
        {
          "type": "function",
          "ref": "components.compliance.zatca_sa.phase1.validate_phase1_invoice"
        }
      ]
    }
  ],
  "requires": [],
  "parameters": [],
  "tests": [
