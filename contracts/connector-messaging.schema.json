{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:platform:contract:connector-messaging:0.1.0",
  "version": "0.1.0",
  "title": "Messaging and SMS connector objects",
  "description": "Draft (ADR-0078 Proposed, DSC-022). The six objects of connector-messaging.md, told apart by kind. Unknown keys are refused. Rules JSON Schema cannot express are in x-validator-rules.",
  "x-validator-rules": [
    "tenantId is set by the platform from the verified channel account binding, never from webhook payload text (section 7)",
    "the tenant segment of credentialRef (secret://tenant/<tenant>/msg/...) equals tenantId; a capability whose credentialRef names another tenant is refused (MSG-014)",
    "channelAccountRef, conversationId, contactRef, consentRef, templateId, autoReplyPolicyRef, approvedTextId and testAllowlistRef of a send all resolve inside the send's tenantId; a ref that resolves to another tenant is refused (MSG-014), never followed",
    "a session_reply is refused unless the conversation's windowOpenUntil is set and now is before it; when windowOpenUntil is null (SMS, or no inbound yet) the session reply is refused and a template is required (MSG-003)",
    "a template send is refused unless the template is approved for that language and category, and consentRef is the latest record by recordedAt for the same tenant, contactRef, channel, country and purpose covering the category, in state granted (MSG-004, MSG-005, MSG-006)",
    "consent records of one key (tenant, contactRef, channel, country, purpose) are ordered only by recordedAt, which platform code sets when it appends the record and which is strictly later than the key's latest record; capturedAt is tenant-supplied evidence and never orders records",
    "supersedes names the latest record (by recordedAt) for the record's key at the moment it is appended; it is null only when no record exists for that key; any other value, including null after a STOP, is refused and the record is not appended",
    "a granted consent record whose superseded record is a revoke carries afterRevocation, copied by platform code from that revoke (consentId, revokedBy, revokedAt); its capturedAt is after afterRevocation.revokedAt and its evidenceHash is new; a revoke by the contact or a provider block is lifted only by the contact's own opt-in (capturedBy contact), never by a tenant user",
    "payloadHash is the sha256 of the canonical send_request (UTF-8 JSON, sorted keys, no whitespace) without payloadHash, confirmationId, approvalId and sentBy, so it covers the content that was approved and does not change when the confirming user is recorded; recomputed by platform code at confirmation and at execution; any mismatch voids the confirmation and the approval (action-policy section 5)",
    "sentBy is the user who made the confirmation gesture over the rendering of that payloadHash; for agent_draft, sentBy differs from draftedBy: the schema makes them disjoint (usr_ against agt_ ids) and the validator also checks that sentBy resolves to a human user of the tenant, never an agent or service principal",
    "tainted is set by platform code, never by the caller: it is true for any send whose contact has a conversation holding inbound content on that channel account, whatever the mode or category (the schema forces it when conversationId is present)",
    "a send with riskClass null is refused: no action-policy row exists for it; auto_reply therefore cannot execute until an AP-MSG row is accepted and a later contract version names that row in riskClass",
    "conversation windowOpenUntil is computed by platform code as min(providerSentAt, webhook.receivedAt) of the latest inbound message plus serviceWindowHours, from the provider timestamp in the signed body, never from our receive time alone; a message without providerSentAt never opens or extends a window",
    "an inbound message whose providerSentAt is older than webhook.maxEventAgeHours, or more than 300 seconds ahead of webhook.receivedAt, is dropped, alerted and audited and becomes no object, except an opt-out keyword, which is still processed as a revoke and never opens a window",
    "dedup keys are stored durably (dedupStore durable) for dedupRetentionHours; loss of the dedup store fails closed: inbound processing stops until it is restored",
    "an auto_reply send has no text field: the platform resolves approvedTextId to the tenant-approved text of autoReplyPolicyRef for classifiedIntent, byte for byte; it is refused unless confidence >= confidenceThreshold and the inbound message has no flags (section 5)",
    "contentHash is the sha256 of the sanitised text, recomputed by platform code; never taken from the provider",
    "a send under a capability with sandbox true is refused unless contactRef is on the tenant test allowlist named by testAllowlistRef (MSG-012); a capability with sandbox true is refused in a production site class",
    "a webhook whose eventType is not in the schema's list is dropped, alerted and audited, and becomes no object (MSG-013)",
    "contactRef resolves to a verified contact field of the tenant record; the model never chooses a recipient (prompt-injection-defence 5.1)"
  ],
  "type": "object",
  "required": ["kind", "tenantId"],
  "properties": {"kind": {"enum": ["capability", "conversation", "inbound_message", "send_request", "delivery_status", "consent_record"]}},
  "oneOf": [
    {"$ref": "#/$defs/capability"}, {"$ref": "#/$defs/conversation"}, {"$ref": "#/$defs/inboundMessage"},
    {"$ref": "#/$defs/sendRequest"}, {"$ref": "#/$defs/deliveryStatus"}, {"$ref": "#/$defs/consentRecord"}
  ],
  "$defs": {
    "tenantId": {"type": "string", "pattern": "^t_[a-z0-9_]{1,40}$"},
    "ref": {"type": "string", "pattern": "^[a-z]{2,4}_[A-Za-z0-9_-]{1,64}$"},
    "providerId": {"type": "string", "pattern": "^[A-Za-z0-9_.:=+/-]{1,128}$"},
    "channel": {"enum": ["whatsapp", "instagram", "messenger", "sms"]},
    "metaChannel": {"enum": ["whatsapp", "instagram", "messenger"]},
    "country": {"enum": ["SA", "AE", "EG", "QA"]},
    "time": {"type": "string", "format": "date-time"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "contactRevokedBy": {"enum": ["contact_keyword", "contact_request", "provider_block"]},
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "tenantId", "connectorId", "connectorVersion", "channel", "channelAccountRef", "credentialRef", "serviceWindowHours", "templatesRequiredOutsideWindow", "inboundContent", "maxTextLength", "sandbox", "siteClass", "webhook"],
      "properties": {
        "kind": {"const": "capability"}, "tenantId": {"$ref": "#/$defs/tenantId"},
        "connectorId": {"enum": ["msg.meta_whatsapp", "msg.meta_instagram", "msg.meta_messenger", "msg.sms"]},
        "connectorVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "channel": {"$ref": "#/$defs/channel"},
        "channelAccountRef": {"$ref": "#/$defs/ref"},
        "credentialRef": {"type": "string", "pattern": "^secret://tenant/t_[a-z0-9_]{1,40}/msg/[a-z0-9_-]+$"},
        "serviceWindowHours": {"type": ["integer", "null"], "minimum": 1, "maximum": 168},
        "templatesRequiredOutsideWindow": {"type": "boolean"},
        "inboundContent": {"type": "array", "items": {"enum": ["text"]}, "minItems": 1, "uniqueItems": true},
        "maxTextLength": {"type": "integer", "minimum": 1, "maximum": 4096},
        "readReceipts": {"type": "boolean"},
        "sandbox": {"type": "boolean"},
        "siteClass": {"enum": ["sandbox", "production"]},
        "webhook": {
          "type": "object", "additionalProperties": false, "required": ["signedTimestamp", "replayWindowSeconds", "payloadTimestamp", "maxEventAgeHours", "dedupRetentionHours", "dedupStore"],
          "properties": {
            "signedTimestamp": {"type": "boolean"},
            "replayWindowSeconds": {"type": ["integer", "null"], "minimum": 60, "maximum": 3600},
            "payloadTimestamp": {"type": "boolean", "description": "The signed body carries a per-message provider timestamp (providerSentAt). Meta: true as assumed, UNVERIFIED (Q-721)."},
            "maxEventAgeHours": {"type": ["integer", "null"], "minimum": 37, "maximum": 72, "description": "Drop a message whose providerSentAt is older than this: above Meta's 36-hour retry period, never above the dedup retention minimum, so every replay is either deduplicated or too old."},
            "dedupRetentionHours": {"type": "integer", "minimum": 72, "maximum": 2160},
            "dedupStore": {"const": "durable", "description": "Seen dedup keys are kept in a durable store for dedupRetentionHours, never an in-memory or evictable cache."}
          },
          "allOf": [
            {"if": {"properties": {"signedTimestamp": {"const": false}}}, "then": {"properties": {"replayWindowSeconds": {"type": "null"}}}, "else": {"properties": {"replayWindowSeconds": {"type": "integer"}}}},
            {"if": {"properties": {"payloadTimestamp": {"const": true}}}, "then": {"properties": {"maxEventAgeHours": {"type": "integer"}}}, "else": {"properties": {"maxEventAgeHours": {"type": "null"}}}}
          ]
        }
      },
      "allOf": [
        {"if": {"properties": {"connectorId": {"enum": ["msg.meta_whatsapp", "msg.meta_instagram", "msg.meta_messenger"]}}},
         "then": {"properties": {"channel": {"$ref": "#/$defs/metaChannel"}, "webhook": {"properties": {"signedTimestamp": {"const": false}, "payloadTimestamp": {"const": true}}}}},
         "else": {"properties": {"channel": {"const": "sms"}, "serviceWindowHours": {"type": "null"}}}},
        {"if": {"properties": {"siteClass": {"const": "production"}}}, "then": {"properties": {"sandbox": {"const": false}}}}
      ]
    },
    "conversation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "tenantId", "conversationId", "channel", "channelAccountRef", "contactRef", "state", "windowOpenUntil"],
      "properties": {
        "kind": {"const": "conversation"}, "tenantId": {"$ref": "#/$defs/tenantId"},
        "conversationId": {"$ref": "#/$defs/ref"}, "channel": {"$ref": "#/$defs/channel"},
        "channelAccountRef": {"$ref": "#/$defs/ref"}, "contactRef": {"$ref": "#/$defs/ref"},
        "state": {"enum": ["open", "closed", "blocked"]},
        "windowOpenUntil": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
        "lastInboundAt": {"$ref": "#/$defs/time"},
        "assignedTo": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}
      },
      "if": {"properties": {"channel": {"const": "sms"}}}, "then": {"properties": {"windowOpenUntil": {"type": "null"}}}
    },
    "inboundMessage": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "tenantId", "messageId", "providerMessageId", "conversationId", "channel", "providerSentAt", "receivedAt", "trust", "retentionClass", "content", "webhook"],
      "properties": {
        "kind": {"const": "inbound_message"}, "tenantId": {"$ref": "#/$defs/tenantId"},
        "messageId": {"$ref": "#/$defs/ref"}, "providerMessageId": {"$ref": "#/$defs/providerId"},
        "conversationId": {"$ref": "#/$defs/ref"}, "channel": {"$ref": "#/$defs/channel"},
        "providerSentAt": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}], "description": "The provider's message timestamp read from the signed body; null only for a provider whose payload carries none (never on a Meta channel)."},
        "receivedAt": {"$ref": "#/$defs/time"},
        "trust": {"const": "untrusted"},
        "retentionClass": {"const": "transcript"},
        "content": {
          "type": "object", "additionalProperties": false, "required": ["type", "contentHash", "flags"],
          "properties": {
            "type": {"enum": ["text", "unsupported"]},
            "text": {"type": "string", "maxLength": 4096},
            "contentHash": {"$ref": "#/$defs/hash"},
            "flags": {"type": "array", "items": {"enum": ["instruction_like", "link", "opt_out_keyword", "bidi_override_stripped", "control_chars_stripped", "truncated"]}, "uniqueItems": true}
          },
          "if": {"properties": {"type": {"const": "text"}}}, "then": {"required": ["text"]}, "else": {"not": {"required": ["text"]}}
        },
        "webhook": {
          "type": "object", "additionalProperties": false, "required": ["signatureVerified", "eventType", "providerEventId", "dedupKey", "receivedAt"],
          "properties": {
            "signatureVerified": {"const": true},
            "eventType": {"enum": ["message"]},
            "providerEventId": {"$ref": "#/$defs/providerId"},
            "dedupKey": {"$ref": "#/$defs/hash"},
            "receivedAt": {"$ref": "#/$defs/time"}
          }
        }
      },
      "if": {"properties": {"channel": {"$ref": "#/$defs/metaChannel"}}}, "then": {"properties": {"providerSentAt": {"type": "string"}}}
    },
    "sendRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "tenantId", "idempotencyKey", "channel", "country", "contactRef", "mode", "origin", "payloadHash", "tainted", "sandbox", "riskClass"],
      "properties": {
        "kind": {"const": "send_request"}, "tenantId": {"$ref": "#/$defs/tenantId"},
        "idempotencyKey": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
        "channel": {"$ref": "#/$defs/channel"}, "country": {"$ref": "#/$defs/country"},
        "contactRef": {"$ref": "#/$defs/ref"},
        "conversationId": {"$ref": "#/$defs/ref"},
        "mode": {"enum": ["session_reply", "template"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 4096},
        "template": {
          "type": "object", "additionalProperties": false, "required": ["templateId", "category", "language", "params"],
          "properties": {
            "templateId": {"$ref": "#/$defs/ref"},
            "category": {"enum": ["utility", "marketing"]},
            "language": {"enum": ["ar", "en"]},
            "params": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 200}}
          }
        },
        "consentRef": {"$ref": "#/$defs/ref"},
        "origin": {"enum": ["human", "agent_draft", "auto_reply"]},
        "sentBy": {"type": "string", "pattern": "^usr_[A-Za-z0-9_-]{1,64}$", "description": "A human user id. Disjoint from draftedBy (agent ids), so sentBy can never equal draftedBy."},
        "draftedBy": {"type": "string", "pattern": "^agt_[A-Za-z0-9_-]{1,64}$"},
        "confirmationId": {"$ref": "#/$defs/ref"},
        "payloadHash": {"$ref": "#/$defs/hash"},
        "tainted": {"type": "boolean"},
        "sandbox": {"type": "boolean"},
        "testAllowlistRef": {"$ref": "#/$defs/ref"},
        "autoReplyPolicyRef": {"$ref": "#/$defs/ref"},
        "approvedTextId": {"$ref": "#/$defs/ref"},
        "classifiedIntent": {"enum": ["greeting_ack", "opening_hours", "location", "handoff_ack"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "confidenceThreshold": {"type": "number", "minimum": 0.8, "maximum": 1},
        "riskClass": {"enum": ["R3", null], "description": "Interim, SEC action-policy row pending (Q-720): R3 fail closed for human and agent_draft sends; null (no class) for auto_reply, which is refused while null. A later minor version replaces this with an AP-MSG row reference (contract section 3)."},
        "approvalId": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "session_reply"}}},
         "then": {"required": ["conversationId"], "properties": {"tainted": {"const": true}, "channel": {"$ref": "#/$defs/metaChannel"}}, "not": {"anyOf": [{"required": ["template"]}, {"required": ["consentRef"]}]}},
         "else": {"required": ["template", "consentRef"], "not": {"anyOf": [{"required": ["text"]}, {"required": ["approvedTextId"]}]}}},
        {"if": {"properties": {"channel": {"const": "sms"}}, "required": ["channel"]}, "then": {"properties": {"mode": {"const": "template"}}}},
        {"if": {"properties": {"template": {"properties": {"category": {"const": "marketing"}}, "required": ["category"]}}, "required": ["template"]},
         "then": {"properties": {"origin": {"const": "human"}, "approvalId": {"$ref": "#/$defs/ref"}}, "required": ["approvalId"]}},
        {"if": {"properties": {"origin": {"const": "auto_reply"}}},
         "then": {"required": ["autoReplyPolicyRef", "approvedTextId", "classifiedIntent", "confidence", "confidenceThreshold"],
                  "properties": {"mode": {"const": "session_reply"}, "channel": {"$ref": "#/$defs/metaChannel"}, "riskClass": {"const": null}},
                  "not": {"anyOf": [{"required": ["text"]}, {"required": ["sentBy"]}, {"required": ["draftedBy"]}, {"required": ["confirmationId"]}]}},
         "else": {"required": ["sentBy", "confirmationId"], "properties": {"riskClass": {"const": "R3"}},
                  "not": {"anyOf": [{"required": ["autoReplyPolicyRef"]}, {"required": ["approvedTextId"]}, {"required": ["classifiedIntent"]}, {"required": ["confidence"]}, {"required": ["confidenceThreshold"]}]},
                  "if": {"properties": {"mode": {"const": "session_reply"}}}, "then": {"required": ["text"]}}},
        {"if": {"properties": {"origin": {"const": "agent_draft"}}}, "then": {"required": ["draftedBy"]}, "else": {"not": {"required": ["draftedBy"]}}},
        {"if": {"properties": {"sandbox": {"const": true}}}, "then": {"required": ["testAllowlistRef"]}, "else": {"not": {"required": ["testAllowlistRef"]}}},
        {"if": {"required": ["conversationId"]}, "then": {"properties": {"tainted": {"const": true}}}}
      ]
    },
    "deliveryStatus": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "tenantId", "messageId", "providerMessageId", "status", "occurredAt", "costMicroUsd"],
      "properties": {
        "kind": {"const": "delivery_status"}, "tenantId": {"$ref": "#/$defs/tenantId"},
        "messageId": {"$ref": "#/$defs/ref"}, "providerMessageId": {"$ref": "#/$defs/providerId"},
        "status": {"enum": ["accepted", "sent", "delivered", "read", "failed", "expired"]},
        "occurredAt": {"$ref": "#/$defs/time"},
        "errorCode": {"type": "string", "pattern": "^MSG-[0-9]{3}$"},
        "costMicroUsd": {"type": ["integer", "null"], "minimum": 0}
      },
      "if": {"properties": {"status": {"const": "failed"}}}, "then": {"required": ["errorCode"]}, "else": {"not": {"required": ["errorCode"]}}
    },
    "consentRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "tenantId", "consentId", "contactRef", "channel", "country", "purpose", "state", "capturedAt", "recordedAt", "capturedBy", "method", "textVersion", "language", "evidenceHash", "supersedes"],
      "properties": {
        "kind": {"const": "consent_record"}, "tenantId": {"$ref": "#/$defs/tenantId"},
        "consentId": {"$ref": "#/$defs/ref"}, "contactRef": {"$ref": "#/$defs/ref"},
        "channel": {"$ref": "#/$defs/channel"},
        "country": {"$ref": "#/$defs/country"},
        "purpose": {"enum": ["utility", "marketing"]},
        "state": {"enum": ["granted", "revoked"]},
        "capturedAt": {"$ref": "#/$defs/time"},
        "recordedAt": {"$ref": "#/$defs/time", "description": "Set by platform code when the record is appended; the only ordering key. capturedAt is tenant-supplied and never orders records."},
        "capturedBy": {"enum": ["contact", "tenant_user", "provider"]},
        "method": {"enum": ["web_form", "in_person", "chat_keyword", "sms_keyword", "phone"]},
        "textVersion": {"type": "string", "pattern": "^[a-z0-9_.-]{1,40}$"},
        "language": {"enum": ["ar", "en"]},
        "evidenceHash": {"$ref": "#/$defs/hash"},
        "supersedes": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
        "afterRevocation": {
          "type": "object", "additionalProperties": false, "required": ["consentId", "revokedBy", "revokedAt"],
          "properties": {"consentId": {"$ref": "#/$defs/ref"}, "revokedBy": {"enum": ["contact_keyword", "contact_request", "tenant_user", "provider_block"]}, "revokedAt": {"$ref": "#/$defs/time"}}
        },
        "revokedAt": {"$ref": "#/$defs/time"},
        "revokedBy": {"enum": ["contact_keyword", "contact_request", "tenant_user", "provider_block"]}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "revoked"}}},
         "then": {"required": ["revokedAt", "revokedBy"], "properties": {"supersedes": {"$ref": "#/$defs/ref"}}, "not": {"required": ["afterRevocation"]}},
         "else": {"not": {"anyOf": [{"required": ["revokedAt"]}, {"required": ["revokedBy"]}]}}},
        {"if": {"required": ["afterRevocation"], "properties": {"afterRevocation": {"properties": {"revokedBy": {"$ref": "#/$defs/contactRevokedBy"}}}}},
         "then": {"properties": {"capturedBy": {"const": "contact"}, "method": {"enum": ["web_form", "chat_keyword", "sms_keyword"]}}}}
      ]
    }
  }
}
