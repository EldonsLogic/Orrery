{
  "$schema": "../blueprint.schema.json",
  "meta": { "id": "example-modules-001", "schemaVersion": "0.1.0", "revision": 1, "locales": ["ar", "en"], "defaultLocale": "ar", "buildState": "draft", "createdAt": "2026-01-01T00:00:00Z", "updatedAt": "2026-01-01T00:00:00Z" },
  "company": {
    "legalName": { "ar": "شركة المثال للخدمات", "en": "Example Services Co." },
    "country": "SA",
    "languages": { "primary": "ar", "secondary": ["en"] },
    "sizeBand": "25-49"
  },
  "locations": [
    { "id": "hq", "kind": "branch", "labels": { "ar": "المقر الرئيسي", "en": "Head office" } }
  ],
  "components": [
    { "id": "core.customer", "versionRange": "^0.1.0" },
    { "id": "crm.core", "versionRange": "^0.1.0" },
    { "id": "projects.core", "versionRange": "^0.1.0" }
  ],
  "entities": [
    {
      "id": "customer", "kind": "master",
      "labels": { "ar": "عميل", "en": "Customer" },
      "fields": [{ "id": "customer_name", "type": "string", "required": true, "labels": { "ar": "اسم العميل", "en": "Customer name" } }],
      "components": [{ "component": "core.customer", "mode": "implements" }],
      "provenance": { "source": "template", "humanEdited": false }
    },
    {
      "id": "contact", "kind": "master",
      "labels": { "ar": "جهة اتصال", "en": "Contact" },
      "fields": [{ "id": "full_name", "type": "string", "required": true, "labels": { "ar": "الاسم", "en": "Name" } }, { "id": "mobile", "type": "phone", "labels": { "ar": "الجوال", "en": "Mobile" } }],
      "components": [{ "component": "crm.core", "mode": "implements" }],
      "provenance": { "source": "template", "humanEdited": false }
    },
    {
      "id": "lead", "kind": "master",
      "labels": { "ar": "عميل محتمل", "en": "Lead" },
      "fields": [{ "id": "lead_name", "type": "string", "required": true, "labels": { "ar": "الاسم", "en": "Name" } }, { "id": "campaign", "type": "link", "target": "campaign", "labels": { "ar": "الحملة", "en": "Campaign" } }],
      "components": [{ "component": "crm.core", "mode": "implements" }],
      "provenance": { "source": "template", "humanEdited": false }
    },
    {
      "id": "opportunity", "kind": "master",
      "labels": { "ar": "فرصة بيع", "en": "Opportunity" },
      "fields": [{ "id": "customer", "type": "link", "target": "customer", "required": true, "labels": { "ar": "العميل", "en": "Customer" } }, { "id": "expected_value", "type": "money", "precision": 2, "min": 0, "labels": { "ar": "القيمة المتوقعة", "en": "Expected value" } }],
      "components": [{ "component": "crm.core", "mode": "implements" }],
      "provenance": { "source": "template", "humanEdited": false }
    },
    {
      "id": "crm_activity", "kind": "master",
      "labels": { "ar": "نشاط", "en": "Activity" },
      "fields": [{ "id": "subject", "type": "string", "required": true, "labels": { "ar": "الموضوع", "en": "Subject" } }, { "id": "due_at", "type": "datetime", "labels": { "ar": "الموعد", "en": "Due" } }],
      "components": [{ "component": "crm.core", "mode": "implements" }],
      "provenance": { "source": "template", "humanEdited": false }
    },
    {
      "id": "campaign", "kind": "master",
      "labels": { "ar": "حملة", "en": "Campaign" },
      "fields": [{ "id": "campaign_name", "type": "string", "required": true, "labels": { "ar": "اسم الحملة", "en": "Campaign name" } }],
      "components": [{ "component": "crm.core", "mode": "implements" }],
      "provenance": { "source": "template", "humanEdited": false }
    },
    {
      "id": "project", "kind": "master",
      "labels": { "ar": "مشروع", "en": "Project" },
      "fields": [{ "id": "project_name", "type": "string", "required": true, "labels": { "ar": "اسم المشروع", "en": "Project name" } }],
      "components": [{ "component": "projects.core", "mode": "implements" }],
      "provenance": { "source": "template", "humanEdited": false }
    },
    {
      "id": "task", "kind": "master",
      "labels": { "ar": "مهمة", "en": "Task" },
      "fields": [{ "id": "subject", "type": "string", "required": true, "labels": { "ar": "المهمة", "en": "Task" } }, { "id": "project", "type": "link", "target": "project", "labels": { "ar": "المشروع", "en": "Project" } }, { "id": "start_date", "type": "date", "labels": { "ar": "البداية", "en": "Start" } }, { "id": "end_date", "type": "date", "labels": { "ar": "النهاية", "en": "End" } }],
      "components": [{ "component": "projects.core", "mode": "implements" }],
      "provenance": { "source": "template", "humanEdited": false }
    },
    {
      "id": "timesheet", "kind": "document",
      "labels": { "ar": "سجل الساعات", "en": "Timesheet" },
      "fields": [{ "id": "hours", "type": "decimal", "precision": 2, "min": 0, "labels": { "ar": "الساعات", "en": "Hours" } }],
      "components": [{ "component": "projects.core", "mode": "implements" }],
      "provenance": { "source": "template", "humanEdited": false }
    }
  ],
  "roles": [
    {
      "id": "owner", "function": "owner", "isAdmin": true,
      "labels": { "ar": "المالك", "en": "Owner" },
      "scope": { "type": "company" },
      "permissions": [
        { "entity": "customer", "actions": ["read", "create", "update", "export"] },
        { "entity": "contact", "actions": ["read", "create", "update"] },
        { "entity": "lead", "actions": ["read", "create", "update", "export"] },
        { "entity": "opportunity", "actions": ["read", "create", "update", "export"] },
        { "entity": "crm_activity", "actions": ["read", "create", "update"] },
        { "entity": "campaign", "actions": ["read", "create", "update"] },
        { "entity": "project", "actions": ["read", "create", "update"] },
        { "entity": "task", "actions": ["read", "create", "update"] },
        { "entity": "timesheet", "actions": ["read", "submit"] }
      ],
      "homeView": { "layout": "owner_overview", "reports": ["pipeline_overview", "project_status"] },
      "provenance": { "source": "template", "humanEdited": false }
    },
    {
      "id": "sales_rep", "function": "sales",
      "labels": { "ar": "مندوب مبيعات", "en": "Sales rep" },
      "scope": { "type": "own_records" },
      "permissions": [
        { "entity": "customer", "actions": ["read"] },
        { "entity": "contact", "actions": ["read", "create", "update"] },
        { "entity": "lead", "actions": ["read", "create", "update"] },
        { "entity": "opportunity", "actions": ["read", "create", "update"] },
        { "entity": "crm_activity", "actions": ["read", "create", "update"] },
        { "entity": "project", "actions": ["read"] },
        { "entity": "task", "actions": ["read", "update"] },
        { "entity": "timesheet", "actions": ["read", "create", "update"] }
      ],
      "homeView": { "layout": "task_list" },
      "provenance": { "source": "template", "humanEdited": false }
    }
  ],
  "reports": [
    {
      "id": "pipeline_overview", "kind": "dashboard",
      "labels": { "ar": "خط المبيعات", "en": "Pipeline overview" },
      "entity": "opportunity",
      "metrics": [{ "ref": "crm.weighted_pipeline_value", "display": "kpi" }, { "ref": "crm.win_rate", "display": "kpi" }, { "ref": "crm.leads_by_source", "display": "bar" }],
      "visibleToRoles": ["owner"],
      "provenance": { "source": "template", "humanEdited": false }
    },
    {
      "id": "project_status", "kind": "dashboard",
      "labels": { "ar": "حالة المشاريع", "en": "Project status" },
      "entity": "task",
      "metrics": [{ "ref": "projects.tasks_by_status", "display": "bar" }, { "ref": "projects.overdue_tasks", "display": "kpi" }, { "ref": "projects.hours_logged", "display": "kpi" }],
      "visibleToRoles": ["owner"],
      "provenance": { "source": "template", "humanEdited": false }
    }
  ],
  "compliance": {
    "country": "SA",
    "countryPack": { "id": "sa", "version": "0.1.0" },
    "eInvoicing": { "mode": "none" },
    "vat": { "registered": false },
    "hijriDisplay": { "enabled": true },
    "documentLanguages": ["ar", "en"]
  },
  "i18n": { "defaultLocale": "ar" },
  "branding": {
    "displayName": { "ar": "المثال للخدمات", "en": "Example Services" },
    "primaryColour": "#1F5FAE",
    "poweredBy": { "show": true },
    "provenance": { "source": "template", "humanEdited": false }
  },
  "modules": {
    "crm": {
      "component": "crm.core",
      "entities": { "lead": "lead", "opportunity": "opportunity", "customer": "customer", "contact": "contact", "activity": "crm_activity", "campaign": "campaign" },
      "roles": { "manage": ["owner"], "work": ["sales_rep"] },
      "pipeline": {
        "stages": [
          { "id": "qualify", "kind": "open", "probabilityPercent": 10, "labels": { "ar": "تأهيل", "en": "Qualify" } },
          { "id": "proposal", "kind": "open", "probabilityPercent": 50, "labels": { "ar": "عرض سعر", "en": "Proposal" } },
          { "id": "negotiation", "kind": "open", "probabilityPercent": 75, "labels": { "ar": "تفاوض", "en": "Negotiation" } },
          { "id": "won", "kind": "won", "probabilityPercent": 100, "labels": { "ar": "تم الكسب", "en": "Won" } },
          { "id": "lost", "kind": "lost", "probabilityPercent": 0, "labels": { "ar": "خسارة", "en": "Lost" } }
        ]
      },
      "leadSources": [
        { "id": "referral", "labels": { "ar": "توصية", "en": "Referral" } },
        { "id": "exhibition", "labels": { "ar": "معرض", "en": "Exhibition" } }
      ],
      "lostReasons": [{ "id": "price", "labels": { "ar": "السعر", "en": "Price" } }],
      "activityTypes": ["call", "meeting", "visit", "note", "follow_up"],
      "campaignLink": true,
      "provenance": { "source": "template", "ref": "crm_starter@0.1.0", "humanEdited": false }
    },
    "projects": {
      "component": "projects.core",
      "entities": { "project": "project", "task": "task", "timesheet": "timesheet" },
      "roles": { "manage": ["owner"], "work": ["sales_rep"] },
      "taskStatuses": [
        { "id": "to_do", "engineStatus": "open", "labels": { "ar": "للتنفيذ", "en": "To do" } },
        { "id": "in_progress", "engineStatus": "working", "labels": { "ar": "قيد التنفيذ", "en": "In progress" } },
        { "id": "client_review", "engineStatus": "pending_review", "labels": { "ar": "مراجعة العميل", "en": "Client review" } },
        { "id": "done", "engineStatus": "completed", "labels": { "ar": "منجز", "en": "Done" } }
      ],
      "views": [
        {
          "id": "task_board", "kind": "board", "concept": "task", "visibleToRoles": ["owner", "sales_rep"],
          "labels": { "ar": "لوحة المهام", "en": "Task board" },
          "board": {
            "columns": [
              { "id": "col_to_do", "statuses": ["to_do"], "labels": { "ar": "للتنفيذ", "en": "To do" } },
              { "id": "col_doing", "statuses": ["in_progress", "client_review"], "labels": { "ar": "جارٍ", "en": "Doing" } },
              { "id": "col_done", "statuses": ["done"], "labels": { "ar": "منجز", "en": "Done" } }
            ],
            "swimlanes": "project"
          }
        },
        { "id": "task_timeline", "kind": "timeline", "concept": "task", "visibleToRoles": ["owner"], "labels": { "ar": "الجدول الزمني", "en": "Timeline" }, "timeline": { "startField": "start_date", "endField": "end_date", "showDependencies": true } },
        { "id": "task_calendar", "kind": "calendar", "concept": "task", "visibleToRoles": ["owner", "sales_rep"], "labels": { "ar": "التقويم", "en": "Calendar" }, "calendar": { "startField": "start_date", "endField": "end_date" } }
      ],
      "timesheets": { "enabled": true, "billable": false },
      "provenance": { "source": "template", "ref": "projects_starter@0.1.0", "humanEdited": false }
    }
  }
}
