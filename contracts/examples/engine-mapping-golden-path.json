  "operations": [
    {
      "id": "create_sales_order",
      "description": "Sales creates a draft sales order",
      "blueprintAction": "create",
      "toEntity": "sales_order",
      "engineMethod": "insert a draft Sales Order through the document API",
      "idempotencyKeyParts": [
        "tenant",
        "mapping_version",
        "client_request_id"
      ],
      "humanFloor": false
    },
    {
      "id": "submit_sales_order",
      "description": "Submit the sales order",
      "blueprintAction": "submit",
      "engineMethod": "submit the Sales Order document",
      "idempotencyKeyParts": [
        "tenant",
        "sales_order",
        "sales_order_revision"
      ],
      "preconditions": [
        "order has at least one line",
        "customer and items exist"
      ],
      "humanFloor": false
    },
    {
      "id": "create_delivery_draft_from_order",
      "description": "Warehouse creates the delivery draft from the order",
      "blueprintAction": "create",
      "fromEntity": "sales_order",
      "toEntity": "delivery_note",
      "engineMethod": "mapped document: make a Delivery Note from the Sales Order",
      "idempotencyKeyParts": [
        "tenant",
        "sales_order",
        "sales_order_revision"
      ],
      "preconditions": [
        "sales order is submitted",
        "delivered quantity does not exceed the ordered remaining quantity",
        "stock on hand covers the quantity"
      ],
      "humanFloor": false
    },
    {
      "id": "submit_delivery",
      "description": "Warehouse submits the delivery; the engine posts the stock movement and the cost of goods entry",
      "blueprintAction": "submit",
      "engineMethod": "submit the Delivery Note document",
      "idempotencyKeyParts": [
        "tenant",
        "delivery_note",
        "delivery_note_revision"
      ],
      "preconditions": [
        "a repeat submit creates no second movement"
      ],
      "humanFloor": true,
      "expectedEffects": "docs/specs/golden-path-trading-sale.md section 5"
    },
    {
      "id": "create_invoice_draft_from_delivery",
      "description": "Finance creates the invoice draft from the delivery",
      "blueprintAction": "create",
      "fromEntity": "delivery_note",
      "toEntity": "sales_invoice",
      "engineMethod": "mapped document: make a Sales Invoice from the Delivery Note, with stock update switched off",
      "idempotencyKeyParts": [
        "tenant",
        "delivery_note",
        "delivery_note_revision"
      ],
      "preconditions": [
        "the invoice must not move stock again",
        "invoiced quantity does not exceed delivered quantity"
      ],
      "humanFloor": false
    },
    {
      "id": "post_invoice",
      "description": "Finance posts the invoice to the ledger",
      "blueprintAction": "submit",
      "engineMethod": "submit the Sales Invoice document",
      "idempotencyKeyParts": [
        "tenant",
        "sales_invoice",
        "sales_invoice_revision"
      ],
      "preconditions": [
        "amounts equal the order and delivery lines",
        "a repeat submit creates no second posting"
      ],
      "humanFloor": true,
      "expectedEffects": "docs/specs/golden-path-trading-sale.md section 5"
    }
  ]
