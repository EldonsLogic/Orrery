    {
      "blueprintEntity": "sales_order",
      "engineDocType": "Sales Order",
      "kind": "document",
      "submittable": true,
      "ledgerEffect": "none",
      "fields": [
        {
          "blueprintField": "customer",
          "blueprintType": "link",
          "engineField": "customer",
          "engineType": "Link",
          "engineLinkDoctype": "Customer"
        },
        {
          "blueprintField": "order_date",
          "blueprintType": "date",
          "engineField": "transaction_date",
          "engineType": "Date"
        },
        {
          "blueprintField": "delivery_date",
          "blueprintType": "date",
          "engineField": "delivery_date",
          "engineType": "Date"
        },
        {
          "blueprintField": "warehouse",
          "blueprintType": "select",
          "engineField": "set_warehouse",
          "engineType": "Link",
          "engineLinkDoctype": "Warehouse"
        },
        {
          "blueprintField": "discount_percent",
          "blueprintType": "percent",
          "engineField": "additional_discount_percentage",
          "engineType": "Percent"
        },
        {
          "blueprintField": "subtotal",
          "blueprintType": "money",
          "engineField": "total",
          "engineType": "Currency",
          "computed": {
            "authority": "engine",
            "expression": "sum of line_total",
            "inputs": [
              "line_total"
            ],
            "aggregation": {
              "over": "lines",
              "function": "sum",
              "field": "line_total"
            },
            "rounding": {
              "precision": 2,
              "mode": "half_up"
            },
            "recalculateOn": [
              "line_changed",
              "line_added",
              "line_removed"
            ]
          }
        },
        {
          "blueprintField": "vat_amount",
          "blueprintType": "money",
          "engineField": "total_taxes_and_charges",
          "engineType": "Currency",
          "computed": {
            "authority": "engine",
            "expression": "0 on the golden path (no tax); the tax variant is a later path",
            "inputs": [
              "subtotal"
            ],
            "rounding": {
              "precision": 2,
              "mode": "half_up"
            },
            "recalculateOn": [
              "subtotal_changed",
              "tax_changed"
            ]
          }
        },
        {
          "blueprintField": "total_amount",
          "blueprintType": "money",
          "engineField": "grand_total",
          "engineType": "Currency",
          "computed": {
            "authority": "engine",
            "expression": "subtotal * (1 - discount_percent / 100) + vat_amount",
            "inputs": [
              "subtotal",
              "discount_percent",
              "vat_amount"
            ],
            "rounding": {
              "precision": 2,
              "mode": "half_up"
            },
            "recalculateOn": [
              "subtotal_changed",
              "discount_changed",
              "tax_changed"
            ]
          }
        }
      ]
    },
