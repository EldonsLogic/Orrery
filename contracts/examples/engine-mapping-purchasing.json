  ],
  "operations": [
    {
      "id": "create_purchase_order",
      "description": "Purchasing creates a draft purchase order",
      "blueprintAction": "create",
      "toEntity": "purchase_order",
      "engineMethod": "insert a draft Purchase Order through the document API",
      "idempotencyKeyParts": ["tenant", "mapping_version", "client_request_id"],
      "humanFloor": false
    },
    {
      "id": "submit_purchase_order",
      "description": "Submit the purchase order to the supplier; no posting",
      "blueprintAction": "submit",
      "toEntity": "purchase_order",
      "engineMethod": "submit the Purchase Order document",
      "idempotencyKeyParts": ["tenant", "purchase_order", "purchase_order_revision"],
      "preconditions": ["order has at least one line", "supplier and items exist", "purchase_order_flow reached ordered (approval when its guard asks for it)"],
      "humanFloor": false
    },
    {
      "id": "create_receipt_draft_from_order",
      "description": "Warehouse creates the receipt draft from the order",
      "blueprintAction": "create",
      "fromEntity": "purchase_order",
      "toEntity": "purchase_receipt",
      "engineMethod": "mapped document: make a Purchase Receipt from the Purchase Order",
      "idempotencyKeyParts": ["tenant", "purchase_order", "purchase_order_revision"],
      "preconditions": ["purchase order is submitted", "received quantity does not exceed the ordered remaining quantity"],
      "humanFloor": false
    },
    {
      "id": "submit_receipt",
      "description": "Warehouse submits the receipt; the engine posts the stock movement and the received-not-billed entry",
      "blueprintAction": "submit",
      "toEntity": "purchase_receipt",
      "engineMethod": "submit the Purchase Receipt document",
      "idempotencyKeyParts": ["tenant", "purchase_receipt", "purchase_receipt_revision"],
      "preconditions": ["a repeat submit creates no second movement"],
      "humanFloor": true
    },
    {
      "id": "create_purchase_invoice_draft_from_receipt",
      "description": "Finance creates the supplier invoice draft from the receipt",
      "blueprintAction": "create",
      "fromEntity": "purchase_receipt",
      "toEntity": "purchase_invoice",
      "engineMethod": "mapped document: make a Purchase Invoice from the Purchase Receipt, with stock update switched off",
      "idempotencyKeyParts": ["tenant", "purchase_receipt", "purchase_receipt_revision"],
      "preconditions": ["the invoice must not move stock again", "invoiced quantity does not exceed received quantity"],
      "humanFloor": false
    },
    {
      "id": "post_purchase_invoice",
      "description": "Finance posts the supplier invoice to the ledger",
      "blueprintAction": "submit",
      "toEntity": "purchase_invoice",
      "engineMethod": "submit the Purchase Invoice document",
      "idempotencyKeyParts": ["tenant", "purchase_invoice", "purchase_invoice_revision"],
      "preconditions": ["supplier invoice number is unique per supplier", "a repeat submit creates no second posting"],
      "humanFloor": true
    }
  ],
