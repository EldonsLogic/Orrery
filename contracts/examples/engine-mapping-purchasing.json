        {"blueprintEntity": "price_list", "actions": ["read", "create", "update", "export"]},
        {"blueprintEntity": "purchase_order", "actions": ["read", "create", "update", "cancel", "approve", "export"]},
        {"blueprintEntity": "purchase_receipt", "actions": ["read", "export"]},
        {"blueprintEntity": "purchase_invoice", "actions": ["read", "export"]}
      ]
    },
    {
      "blueprintRole": "general_manager",
      "engineRole": "platform_general_manager",
      "grants": [
        {"blueprintEntity": "supplier", "actions": ["read", "update", "export"]},
        {"blueprintEntity": "price_list", "actions": ["read", "update", "export"]},
        {"blueprintEntity": "purchase_order", "actions": ["read", "update", "cancel", "approve", "export"]},
