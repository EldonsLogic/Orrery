{
  "base": "blueprint-modules-minimal.json",
  "note": "Negative cases for marketing email (ADR-0079, BPL-066, Blueprint 0.9.0). Each case edits the valid base by JSON pointer; the result must fail the Blueprint schema at a path starting with 'expect' (equal to it when 'exact' is true). Run by contracts/tests/test_blueprint_modules.py. Cross-reference rules (connector ids, variant shares, saved block refs, send windows) are validator tests in services/blueprint/tests/test_modules.py.",
  "cases": [
    { "name": "email-without-integration", "remove": ["/modules/marketing/channels/email/integration"], "expect": "modules/marketing/channels/email" },
    { "name": "email-without-campaign-concept", "remove": ["/modules/marketing/entities/email_campaign"], "expect": "modules/marketing/entities" },
    { "name": "email-without-sender", "remove": ["/modules/marketing/channels/email/sender"], "expect": "modules/marketing/channels/email" },
    { "name": "email-without-postal-address", "remove": ["/modules/marketing/channels/email/sender/postalAddress"], "expect": "modules/marketing/channels/email/sender" },
    { "name": "email-sender-bad-domain", "set": { "/modules/marketing/channels/email/sender/fromDomain": "not a domain" }, "expect": "modules/marketing/channels/email/sender/fromDomain" },
    { "name": "email-without-unsubscribe", "remove": ["/modules/marketing/channels/email/unsubscribe"], "expect": "modules/marketing/channels/email" },
    { "name": "email-one-click-off", "set": { "/modules/marketing/channels/email/unsubscribe/oneClick": false }, "expect": "modules/marketing/channels/email/unsubscribe/oneClick" },
    { "name": "email-body-link-off", "set": { "/modules/marketing/channels/email/unsubscribe/bodyLink": false }, "expect": "modules/marketing/channels/email/unsubscribe/bodyLink" },
    { "name": "email-tracking-unknown-kind", "set": { "/modules/marketing/channels/email/tracking/pixel": true }, "expect": "modules/marketing/channels/email/tracking" },
    { "name": "email-no-send-window", "set": { "/modules/marketing/channels/email/sendWindows": [] }, "expect": "modules/marketing/channels/email/sendWindows" },
    { "name": "email-window-other-country", "set": { "/modules/marketing/channels/email/sendWindows/0/country": "US" }, "expect": "modules/marketing/channels/email/sendWindows/0/country" },
    { "name": "email-window-ai-timing", "set": { "/modules/marketing/channels/email/sendWindows/0/optimise": "model" }, "expect": "modules/marketing/channels/email/sendWindows/0" },
    { "name": "email-window-bad-time", "set": { "/modules/marketing/channels/email/sendWindows/0/to": "25:00" }, "expect": "modules/marketing/channels/email/sendWindows/0/to" },
    { "name": "email-only-channel-disabled", "remove": ["/modules/marketing/channels/messaging", "/modules/marketing/emailBlocks", "/modules/marketing/emailTemplates", "/modules/marketing/abTests"], "set": { "/modules/marketing/channels/email/enabled": false }, "expect": "modules/marketing/channels", "exact": true },
    { "name": "templates-without-email-channel", "set": { "/modules/marketing/channels/email/enabled": false }, "expect": "modules/marketing/channels/email/enabled" },
    { "name": "template-without-unsubscribe-block", "remove": ["/modules/marketing/emailTemplates/0/variants/0/unsubscribe"], "expect": "modules/marketing/emailTemplates/0/variants/0" },
    { "name": "template-without-footer", "remove": ["/modules/marketing/emailTemplates/0/variants/1/footer"], "expect": "modules/marketing/emailTemplates/0/variants/1" },
    { "name": "template-without-plain-text", "remove": ["/modules/marketing/emailTemplates/0/variants/0/plainText"], "expect": "modules/marketing/emailTemplates/0/variants/0" },
    { "name": "template-arabic-ltr", "set": { "/modules/marketing/emailTemplates/0/variants/0/direction": "ltr" }, "expect": "modules/marketing/emailTemplates/0/variants/0/direction" },
    { "name": "template-english-rtl", "set": { "/modules/marketing/emailTemplates/0/variants/1/direction": "rtl" }, "expect": "modules/marketing/emailTemplates/0/variants/1/direction" },
    { "name": "template-english-only", "set": { "/modules/marketing/emailTemplates/0/variants/0/locale": "en", "/modules/marketing/emailTemplates/0/variants/0/direction": "ltr" }, "expect": "modules/marketing/emailTemplates/0/variants" },
    { "name": "template-transactional", "set": { "/modules/marketing/emailTemplates/0/category": "transactional" }, "expect": "modules/marketing/emailTemplates/0/category" },
    { "name": "template-hex-colour", "set": { "/modules/marketing/emailTemplates/0/variants/0/blocks/1/tone": "#FF0000" }, "expect": "modules/marketing/emailTemplates/0/variants/0/blocks/1" },
    { "name": "template-font-name", "set": { "/modules/marketing/emailTemplates/0/variants/0/blocks/1/fontFamily": "Arial" }, "expect": "modules/marketing/emailTemplates/0/variants/0/blocks/1" },
    { "name": "template-unsubscribe-text-override", "set": { "/modules/marketing/emailTemplates/0/variants/0/unsubscribe/text": "Manage preferences" }, "expect": "modules/marketing/emailTemplates/0/variants/0/unsubscribe" },
    { "name": "template-raw-html-block", "set": { "/modules/marketing/emailTemplates/0/variants/0/blocks/1/type": "html" }, "expect": "modules/marketing/emailTemplates/0/variants/0/blocks/1" },
    { "name": "template-http-link", "set": { "/modules/marketing/emailTemplates/0/variants/0/blocks/4/href": "http://example.com/offer" }, "expect": "modules/marketing/emailTemplates/0/variants/0/blocks/4" },
    { "name": "saved-block-nested", "set": { "/modules/marketing/emailBlocks/0/block": { "id": "nested", "type": "saved", "ref": "brand_header" } }, "expect": "modules/marketing/emailBlocks/0/block" },
    { "name": "ab-one-variant", "remove": ["/modules/marketing/abTests/0/variants/1"], "expect": "modules/marketing/abTests/0/variants" },
    { "name": "ab-five-variants", "set": { "/modules/marketing/abTests/0/variants": [
      { "id": "variant_a", "sharePercent": 20, "subject": { "ar": "أ", "en": "A" } }, { "id": "variant_b", "sharePercent": 20, "subject": { "ar": "ب", "en": "B" } },
      { "id": "variant_c", "sharePercent": 20, "subject": { "ar": "ج", "en": "C" } }, { "id": "variant_d", "sharePercent": 20, "subject": { "ar": "د", "en": "D" } },
      { "id": "variant_e", "sharePercent": 20, "subject": { "ar": "ه", "en": "E" } }] }, "expect": "modules/marketing/abTests/0/variants" },
    { "name": "ab-without-sample", "remove": ["/modules/marketing/abTests/0/winnerRule/minSamplePerVariant"], "expect": "modules/marketing/abTests/0/winnerRule" },
    { "name": "ab-without-decision-time", "remove": ["/modules/marketing/abTests/0/winnerRule/decideAfterHours"], "expect": "modules/marketing/abTests/0/winnerRule" },
    { "name": "ab-without-release", "remove": ["/modules/marketing/abTests/0/winnerRule/release"], "expect": "modules/marketing/abTests/0/winnerRule" },
    { "name": "ab-model-picks-winner", "set": { "/modules/marketing/abTests/0/winnerRule/metric": "model_choice" }, "expect": "modules/marketing/abTests/0/winnerRule/metric" },
    { "name": "ab-agent-release", "set": { "/modules/marketing/abTests/0/winnerRule/release": "agent" }, "expect": "modules/marketing/abTests/0/winnerRule/release" },
    { "name": "ab-whole-audience", "set": { "/modules/marketing/abTests/0/testAudiencePercent": 100 }, "expect": "modules/marketing/abTests/0/testAudiencePercent" },
    { "name": "ab-subject-test-without-template", "remove": ["/modules/marketing/abTests/0/templateId"], "expect": "modules/marketing/abTests/0" },
    { "name": "ab-subject-variant-without-subject", "remove": ["/modules/marketing/abTests/0/variants/0/subject"], "expect": "modules/marketing/abTests/0/variants/0" },
    { "name": "ab-content-test-with-subjects", "set": { "/modules/marketing/abTests/0/on": "content" }, "expect": "modules/marketing/abTests/0" }
  ]
}
