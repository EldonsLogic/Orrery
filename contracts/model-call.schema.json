{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:platform:contract:model-call:0.1.0",
  "version": "0.1.0",
  "title": "Model call",
  "description": "One model call through the gateway: a request, a reply or a refusal (contracts/model-call.md). Callers name a tier and purpose, never a model. Rules JSON Schema cannot express are in x-validator-rules.",
  "x-validator-rules": [
    "blocks are ordered platform, tenant_config, user, untrusted (section 3)",
    "caller must equal the authenticated service session (section 1 rule 2)",
    "accepts_untrusted false with any untrusted block is refusal injection_tainted",
    "min_output_tokens <= max_output_tokens"
  ],
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/reply" },
    { "$ref": "#/$defs/refusal" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "caller": {
      "type": "object",
      "required": ["tenant_id", "actor_kind", "actor_id", "correlation_id", "role_ids"],
      "additionalProperties": false,
      "properties": {
        "tenant_id": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,64}$", "not": { "const": "platform" } },
        "actor_kind": { "enum": ["user", "agent", "system", "support"] },
        "actor_id": { "$ref": "#/$defs/id" },
        "correlation_id": { "$ref": "#/$defs/id" },
        "role_ids": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/id" } },
        "session_id": { "$ref": "#/$defs/id" },
        "on_behalf_of": { "$ref": "#/$defs/id" },
        "agent_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" }
      }
    },
    "block": {
      "type": "object",
      "required": ["content_id", "trust", "text", "data_class"],
      "additionalProperties": false,
      "properties": {
        "content_id": { "$ref": "#/$defs/id" },
        "trust": { "enum": ["platform", "tenant_config", "user", "untrusted"] },
        "text": { "type": "string" },
        "data_class": { "enum": ["C0", "C1", "C2", "C3"] },
        "source": { "type": "string", "maxLength": 256 },
        "parents": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "transform": { "enum": ["ocr", "parse", "normalise", "summarise", "translate", "model_output", "memory_read"] },
        "flags": { "type": "array", "items": { "type": "string", "maxLength": 64 } },
        "content_hash": { "type": "string", "maxLength": 128 }
      },
      "if": { "properties": { "trust": { "const": "untrusted" } } },
      "then": { "required": ["source"] }
    },
    "tool": {
      "type": "object",
      "required": ["name", "description", "input_schema"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_.]{0,63}$" },
        "description": { "type": "string", "maxLength": 1024 },
        "input_schema": { "type": "object" }
      }
    },
    "request": {
      "type": "object",
      "required": ["kind", "contract_version", "call_id", "idempotency_key", "caller", "tier", "purpose", "prompt_version", "blocks", "max_output_tokens", "accepts_untrusted"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "request" },
        "contract_version": { "const": "0.1.0" },
        "call_id": { "$ref": "#/$defs/id" },
        "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 128 },
        "caller": { "$ref": "#/$defs/caller" },
        "tier": { "enum": ["frontier", "mid", "small"] },
        "purpose": { "enum": ["chat", "agent", "build", "simulation"] },
        "prompt_version": { "$ref": "#/$defs/id" },
        "blocks": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/block" } },
        "tools": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/tool" } },
        "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 32000 },
        "min_output_tokens": { "type": "integer", "minimum": 1, "maximum": 32000 },
        "accepts_untrusted": { "type": "boolean" },
        "locale": { "enum": ["ar", "en"] },
        "metadata": {
          "type": "object", "maxProperties": 16,
          "propertyNames": { "not": { "pattern": "(?i)^tenant" } },
          "additionalProperties": { "type": "string", "maxLength": 256 }
        }
      }
    },
    "reply": {
      "type": "object",
      "required": ["kind", "call_id", "idempotency_key", "tier", "text", "tool_calls", "stop_reason", "trust", "tainted", "usage", "attempts", "fallback_used", "meter_event_id", "model_id", "replayed"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "reply" },
        "call_id": { "$ref": "#/$defs/id" },
        "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 128 },
        "tier": { "enum": ["frontier", "mid", "small"] },
        "text": { "type": "string" },
        "tool_calls": {
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "name", "arguments"], "additionalProperties": false,
            "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string" }, "arguments": { "type": "object" } }
          }
        },
        "stop_reason": { "enum": ["end", "max_output", "tool_use"] },
        "trust": { "const": "untrusted" },
        "tainted": { "type": "boolean" },
        "usage": {
          "type": "object",
          "required": ["input_tokens", "output_tokens", "cached_tokens", "cost_micro_usd"],
          "additionalProperties": false,
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "cached_tokens": { "type": "integer", "minimum": 0 },
            "cost_micro_usd": { "type": "integer", "minimum": 0 }
          }
        },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "fallback_used": { "type": "boolean" },
        "meter_event_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
        "model_id": { "$ref": "#/$defs/id", "description": "Internal only; never shown to customers." },
        "replayed": { "type": "boolean" }
      }
    },
    "refusal": {
      "type": "object",
      "required": ["kind", "call_id", "code", "reason", "retryable", "reservation_released"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "refusal" },
        "call_id": { "$ref": "#/$defs/id" },
        "code": { "enum": ["budget_refused", "kill_switch_engaged", "region_policy_refused", "model_unavailable", "invalid_request", "injection_tainted", "filter_blocked"] },
        "reason": { "type": "string", "pattern": "^[a-z_]{1,64}$" },
        "retryable": { "type": "boolean" },
        "reservation_released": { "const": true }
      }
    }
  }
}
