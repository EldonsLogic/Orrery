{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:platform:contract:model-call:0.3.0",
  "version": "0.3.0",
  "title": "Model call",
  "description": "One model call through the gateway: a request, a reply or a refusal (contracts/model-call.md). Callers name a tier and purpose, never a model. Platform and tenant-config content travels by reference only. Rules JSON Schema cannot express are in x-validator-rules.",
  "x-validator-rules": [
    "the serialized request, in canonical unescaped UTF-8 form (sorted keys, no \\u escapes for non-ASCII), is at most 1048576 bytes (invalid_request schema)",
    "block content_ids are unique and tool names are unique within a request (invalid_request schema); a string with a lone surrogate or nesting too deep to serialize is invalid_request schema, never an error",
    "a block with trust user needs a principal that is a user (actor_kind user) or acts on_behalf_of one (caller_mismatch)",
    "prompt_version must be a release active for the calling service identity, and each tool must be in the run-token tool grant (ref_mismatch)",
    "blocks are ordered: all platform, then all tenant_config, then conversation blocks with non-decreasing turn (block_order)",
    "platform blocks and tools resolve in the release manifest of prompt_version; tenant_config blocks resolve in the tenant's applied revision revision_id; an unknown reference is unknown_ref; a content_hash or data_class that differs from the resolved entry is ref_mismatch",
    "caller is compared with the verified principal and the signed run token; any difference is caller_mismatch; the gateway never reads identity from the body",
    "accepts_untrusted false with any untrusted block is refusal injection_tainted",
    "min_output_tokens <= max_output_tokens (limit)",
    "token_id is sent only for a user actor, where actor_id is the per-tenant memberRef; both come from the verified claims and are compared like the rest of caller (caller_mismatch); actor_kind comes from the verified claims, never hard-coded",
    "a conversation item is PD when its flags hold pd; it is not PD only when its flags hold pd_none; an item with neither counts as PD (unreadable is PD). A tenant_config block is PD per its resolved Blueprint entry, unreadable counts as PD. A platform block is never PD",
    "a block whose data_class is above the run grant's data class is invalid_request data_class_above_grant; a PD block the region policy does not let leave is region_policy_refused pd_not_allowed",
    "output_schema names a schema in the release manifest of prompt_version (unknown_ref; a differing content_hash is ref_mismatch); a reply that does not conform is filter_blocked output_schema_mismatch, charged, content withheld",
    "a response-cache hit is a reply with cache_hit true, usage all zero, and its own meter_event_id; it is not a dispatch and has no reservation",
    "the reservation TTL is at least 3 times the largest attempt timeout plus a margin; a provider reply after the hold was released is committed as an overrun with one meter.ai_usage event and an alert, its content discarded",
    "a reply tool_call's serialized arguments are at most 65536 UTF-8 bytes"
  ],
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/reply" },
    { "$ref": "#/$defs/refusal" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "data_class": { "enum": ["C0", "C1", "C2", "C3"] },
    "caller": {
      "type": "object",
      "description": "Compared only: must equal the verified principal (tenant, actor, roles, session) and the signed run token (agent_id, run_id).",
      "required": ["tenant_id", "actor_kind", "actor_id", "correlation_id", "role_ids"],
      "additionalProperties": false,
      "properties": {
        "tenant_id": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,64}$", "not": { "const": "platform" } },
        "actor_kind": { "enum": ["user", "agent", "system", "support"] },
        "actor_id": { "$ref": "#/$defs/id" },
        "correlation_id": { "$ref": "#/$defs/id", "description": "The end-to-end audit id (the gateway's audit_id); the only caller field taken from the body." },
        "token_id": { "$ref": "#/$defs/id", "description": "User actors only: the verified token id; actor_id is then the per-tenant memberRef." },
        "role_ids": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "session_id": { "$ref": "#/$defs/id" },
        "on_behalf_of": { "$ref": "#/$defs/id" },
        "agent_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "thread_id": { "$ref": "#/$defs/id" }
      }
    },
    "platform_block": {
      "type": "object",
      "description": "L0 by reference: content_id in the release manifest of prompt_version. No inline text.",
      "required": ["content_id", "trust", "data_class"],
      "additionalProperties": false,
      "properties": {
        "content_id": { "$ref": "#/$defs/id" },
        "trust": { "const": "platform" },
        "data_class": { "enum": ["C0", "C1"] },
        "content_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "tenant_config_block": {
      "type": "object",
      "description": "L1 by reference: content_id in the tenant's applied revision revision_id. No inline text.",
      "required": ["content_id", "trust", "data_class", "revision_id"],
      "additionalProperties": false,
      "properties": {
        "content_id": { "$ref": "#/$defs/id" },
        "trust": { "const": "tenant_config" },
        "data_class": { "$ref": "#/$defs/data_class" },
        "revision_id": { "$ref": "#/$defs/id" },
        "content_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "conversation_block": {
      "type": "object",
      "description": "One item of one conversation turn. Assistant and tool items are always untrusted (L3).",
      "required": ["content_id", "trust", "role", "turn", "text", "data_class"],
      "additionalProperties": false,
      "properties": {
        "content_id": { "$ref": "#/$defs/id" },
        "trust": { "enum": ["user", "untrusted"] },
        "role": { "enum": ["user", "assistant", "tool"] },
        "turn": { "type": "integer", "minimum": 0, "maximum": 1023 },
        "text": { "type": "string", "maxLength": 262144 },
        "data_class": { "$ref": "#/$defs/data_class" },
        "source": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_.:/ -]+$" },
        "parents": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "transform": { "enum": ["ocr", "parse", "normalise", "summarise", "translate", "model_output", "memory_read"] },
        "flags": { "type": "array", "maxItems": 16, "uniqueItems": true, "description": "Reserved: pd (personal data), pd_none (caller asserts none). Neither means unreadable, which counts as PD.", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" } },
        "content_hash": { "$ref": "#/$defs/hash" }
      },
      "allOf": [
        { "if": { "properties": { "trust": { "const": "untrusted" } } }, "then": { "required": ["source"] } },
        { "if": { "properties": { "role": { "enum": ["assistant", "tool"] } } }, "then": { "properties": { "trust": { "const": "untrusted" } } } }
      ]
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/platform_block" },
        { "$ref": "#/$defs/tenant_config_block" },
        { "$ref": "#/$defs/conversation_block" }
      ]
    },
    "tool_ref": {
      "type": "object",
      "description": "L0 tool spec by reference: name in the release manifest of prompt_version.",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_.]{0,63}$" },
        "content_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "output_schema_ref": {
      "type": "object",
      "description": "Structured-output schema by reference: name in the release manifest of prompt_version. No inline schema.",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_.]{0,63}$" },
        "content_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Allow-listed trace keys only; values are ids, never content.",
      "additionalProperties": false,
      "properties": {
        "feature": { "$ref": "#/$defs/id" },
        "step": { "$ref": "#/$defs/id" },
        "eval_case_id": { "$ref": "#/$defs/id" },
        "trace_parent": { "type": "string", "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$" }
      }
    },
    "request": {
      "type": "object",
      "required": ["kind", "contract_version", "call_id", "idempotency_key", "caller", "tier", "purpose", "prompt_version", "blocks", "max_output_tokens", "accepts_untrusted", "thread_tainted"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "request" },
        "contract_version": { "const": "0.3.0" },
        "call_id": { "$ref": "#/$defs/id" },
        "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{8,128}$" },
        "caller": { "$ref": "#/$defs/caller" },
        "tier": { "enum": ["frontier", "mid", "small"] },
        "purpose": { "enum": ["chat", "agent", "build", "simulation"] },
        "prompt_version": { "$ref": "#/$defs/id" },
        "blocks": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/block" } },
        "tools": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/tool_ref" } },
        "output_schema": { "$ref": "#/$defs/output_schema_ref" },
        "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 32000 },
        "min_output_tokens": { "type": "integer", "minimum": 1, "maximum": 32000 },
        "accepts_untrusted": { "type": "boolean" },
        "thread_tainted": { "type": "boolean" },
        "locale": { "enum": ["ar", "en"] },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "reply": {
      "type": "object",
      "required": ["kind", "call_id", "idempotency_key", "tier", "text", "tool_calls", "stop_reason", "trust", "tainted", "usage", "attempts", "fallback_used", "meter_event_id", "replayed", "cache_hit"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "reply" },
        "call_id": { "$ref": "#/$defs/id" },
        "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{8,128}$" },
        "tier": { "enum": ["frontier", "mid", "small"] },
        "text": { "type": "string", "maxLength": 262144 },
        "tool_calls": {
          "type": "array", "maxItems": 64,
          "items": {
            "type": "object", "required": ["id", "name", "arguments"], "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_.]{0,63}$" },
              "arguments": { "type": "object", "maxProperties": 64 }
            }
          }
        },
        "stop_reason": { "enum": ["end", "max_output", "tool_use"] },
        "trust": { "const": "untrusted" },
        "tainted": { "type": "boolean" },
        "usage": {
          "type": "object",
          "required": ["input_tokens", "output_tokens", "cached_tokens", "cost_micro_usd"],
          "additionalProperties": false,
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0, "maximum": 10000000 },
            "output_tokens": { "type": "integer", "minimum": 0, "maximum": 32000 },
            "cached_tokens": { "type": "integer", "minimum": 0, "maximum": 10000000 },
            "cost_micro_usd": { "type": "integer", "minimum": 0, "maximum": 1000000000000 }
          }
        },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "fallback_used": { "type": "boolean" },
        "meter_event_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
        "replayed": { "type": "boolean" },
        "cache_hit": { "type": "boolean", "description": "true: served from the platform response cache; usage is all zero and meter_event_id is its own event." }
      }
    },
    "refusal": {
      "type": "object",
      "required": ["kind", "call_id", "code", "reason", "retryable", "reservation_released"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "refusal" },
        "call_id": { "description": "The request call_id when it matched the id pattern, else null; never other caller text.", "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "code": { "enum": ["budget_refused", "kill_switch_engaged", "region_policy_refused", "model_unavailable", "invalid_request", "injection_tainted", "filter_blocked"] },
        "reason": { "type": "string" },
        "retryable": { "type": "boolean" },
        "reservation_released": { "type": "boolean", "description": "true: nothing was charged. false: dispatch began (including an earlier fallback attempt), the actual cost was committed and metered, and only the content was withheld or a later step refused." }
      },
      "allOf": [
        { "if": { "properties": { "code": { "const": "budget_refused" } } }, "then": { "properties": { "reason": { "enum": ["exceeded", "policy_missing", "meter_unavailable", "layer_unbound"] }, "retryable": { "const": false } } } },
        { "if": { "properties": { "code": { "const": "kill_switch_engaged" } } }, "then": { "properties": { "reason": { "enum": ["engaged", "unreachable"] }, "retryable": { "const": false }, "reservation_released": { "const": true } } } },
        { "if": { "properties": { "code": { "const": "region_policy_refused" } } }, "then": { "properties": { "reason": { "enum": ["policy_missing", "data_class_not_allowed", "pd_not_allowed", "no_allowed_endpoint"] }, "retryable": { "const": false }, "reservation_released": { "const": true } } } },
        { "if": { "properties": { "code": { "const": "model_unavailable" } } }, "then": { "properties": { "reason": { "enum": ["chain_exhausted"] }, "retryable": { "const": true } } } },
        { "if": { "properties": { "code": { "const": "invalid_request" } } }, "then": { "properties": { "reason": { "enum": ["schema", "model_named", "caller_mismatch", "tenant_in_payload", "missing_trust_label", "block_order", "ref_required", "unknown_ref", "ref_mismatch", "idempotency_conflict", "idempotency_in_flight", "limit", "data_class_above_grant"] }, "retryable": { "const": false }, "reservation_released": { "const": true } } } },
        { "if": { "properties": { "code": { "const": "injection_tainted" } } }, "then": { "properties": { "reason": { "enum": ["untrusted_not_accepted"] }, "retryable": { "const": false }, "reservation_released": { "const": true } } } },
        { "if": { "properties": { "code": { "const": "filter_blocked" } } }, "then": { "properties": { "reason": { "enum": ["flagged", "filter_unavailable", "output_schema_mismatch"] }, "retryable": { "const": false } } } }
      ]
    }
  }
}
