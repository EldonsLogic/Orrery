{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:platform:contract:tool-api:error-catalog:0.1.0",
  "version": "0.1.0",
  "title": "Tool API: domain error catalog",
  "description": "Versioned catalog of business error codes carried in the optional domain block of a Tool API error (tool-api.md section 7). All customer-visible text comes from here, never from the engine.",
  "type": "object",
  "required": ["version", "entries"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "slot": {
      "type": "object",
      "required": ["type", "max_length"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["string", "integer", "decimal_string", "id", "date"] },
        "max_length": { "type": "integer", "minimum": 1, "maximum": 256 },
        "enum": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z_]{1,32}$" }, "description": "Closed value list; a string slot needs enum or escaped." },
        "escaped": { "const": true, "description": "Marks a free-text slot; the renderer escapes it." }
      }
    },
    "entry": {
      "type": "object",
      "required": ["id", "class", "retryable", "params", "message_key", "messages", "review", "owner_action"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,47}$" },
        "class": { "enum": ["guard_failed", "conflict", "engine_error", "invalid_arguments", "permission_denied"] },
        "retryable": { "type": "boolean" },
        "params": { "type": "object", "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,31}$" }, "additionalProperties": { "$ref": "#/$defs/slot" } },
        "message_key": { "type": "string", "pattern": "^errors\\.domain\\.[a-z][a-z0-9_]+$" },
        "messages": {
          "type": "object", "required": ["en", "ar"], "additionalProperties": false,
          "properties": { "en": { "type": "string", "minLength": 1, "maxLength": 300 }, "ar": { "type": "string", "minLength": 1, "maxLength": 300 } }
        },
        "review": { "enum": ["unreviewed", "reviewed"], "description": "Arabic review state (ADR-0033)." },
        "owner_action": { "enum": ["retry_later", "retry_after_refresh", "ask_owner", "fix_input", "contact_support"] }
      }
    }
  }
}
