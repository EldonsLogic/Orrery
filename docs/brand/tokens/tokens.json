{
  "$comment": "Source: Brand guidelines v1 (Quadrant), 6 November 2026. Only values printed in the PDF. INTERIM, name not cleared.",
  "color": {
    "light": {
      "background": {"name": "Chalk",   "hex": "#F3F4F6", "role": "Background", "cssVar": "--color-background"},
      "surface":    {"name": "Panel",   "hex": "#FFFFFF", "role": "Surface",    "cssVar": "--color-surface"},
      "text":       {"name": "Carbon",  "hex": "#12151B", "role": "Text",       "cssVar": "--color-text"},
      "primary":    {"name": "Cobalt",  "hex": "#2443D0", "role": "Primary",    "cssVar": "--color-primary"},
      "accent":     {"name": "Coral",   "hex": "#E0552C", "role": "Accent",     "cssVar": "--color-accent"},
      "success":    {"name": "Jade",    "hex": "#13795B", "role": "Success",    "cssVar": "--color-success"},
      "warning":    {"name": "Ochre",   "hex": "#9E5600", "role": "Warning",    "cssVar": "--color-warning"},
      "danger":     {"name": "Crimson", "hex": "#C21F3A", "role": "Danger",     "cssVar": "--color-danger"}
    },
    "dark": {
      "background": {"name": "Carbon",  "hex": "#0E1117", "role": "Background", "cssVar": "--color-background"},
      "surface":    {"name": "Panel",   "hex": "#171B23", "role": "Surface",    "cssVar": "--color-surface"},
      "text":       {"name": "Chalk",   "hex": "#E8EAEF", "role": "Text",       "cssVar": "--color-text"},
      "primary":    {"name": "Cobalt",  "hex": "#86A0FF", "role": "Primary",    "cssVar": "--color-primary"},
      "accent":     {"name": "Coral",   "hex": "#FF8A63", "role": "Accent",     "cssVar": "--color-accent"},
      "success":    {"name": "Jade",    "hex": "#4CC79A", "role": "Success",    "cssVar": "--color-success"},
      "warning":    {"name": "Ochre",   "hex": "#F2A541", "role": "Warning",    "cssVar": "--color-warning"},
      "danger":     {"name": "Crimson", "hex": "#FF6B81", "role": "Danger",     "cssVar": "--color-danger"}
    },
    "proportion": {"chalkAndPanel": 0.70, "carbonText": 0.20, "cobalt": 0.08, "coral": 0.02, "note": "About 70/20/8/2. Coral is for graphics only."},
    "literals": {"white": "#FFFFFF", "carbonOnDarkLabel": "#0E1117", "statusTintOpacity": 0.14, "secondaryBorderOpacity": 0.40}
  },
  "claimedContrast": {
    "$comment": "Ratios stated on PDF page 8. Pair operands are token names, or literal hex. Minimum is 4.5 for text, 3 for non-text graphics.",
    "pairs": [
      {"id": "text-on-background",   "label": "Text on background",                     "fg": {"light": "text",    "dark": "text"},    "bg": {"light": "background", "dark": "background"}, "claimed": {"light": 16.61, "dark": 15.70}, "minimum": 4.5},
      {"id": "text-on-surface",      "label": "Text on surface",                        "fg": {"light": "text",    "dark": "text"},    "bg": {"light": "surface",    "dark": "surface"},    "claimed": {"light": 18.28, "dark": 14.33}, "minimum": 4.5},
      {"id": "primary-on-surface",   "label": "Primary text and links on surface",      "fg": {"light": "primary", "dark": "primary"}, "bg": {"light": "surface",    "dark": "surface"},    "claimed": {"light": 7.53,  "dark": 6.97},  "minimum": 4.5},
      {"id": "button-label-primary", "label": "Button label on primary (white light, Carbon dark)", "fg": {"light": "#FFFFFF", "dark": "#0E1117"}, "bg": {"light": "primary", "dark": "primary"}, "claimed": {"light": 7.53, "dark": 7.64}, "minimum": 4.5},
      {"id": "success-on-surface",   "label": "Success text on surface",                "fg": {"light": "success", "dark": "success"}, "bg": {"light": "surface",    "dark": "surface"},    "claimed": {"light": 5.37,  "dark": 8.17},  "minimum": 4.5},
      {"id": "warning-on-surface",   "label": "Warning text on surface",                "fg": {"light": "warning", "dark": "warning"}, "bg": {"light": "surface",    "dark": "surface"},    "claimed": {"light": 5.55,  "dark": 8.41},  "minimum": 4.5},
      {"id": "danger-on-surface",    "label": "Danger text on surface",                 "fg": {"light": "danger",  "dark": "danger"},  "bg": {"light": "surface",    "dark": "surface"},    "claimed": {"light": 5.91,  "dark": 6.30},  "minimum": 4.5},
      {"id": "accent-on-background", "label": "Accent graphic on background (non-text)", "fg": {"light": "accent",  "dark": "accent"},  "bg": {"light": "background", "dark": "background"}, "claimed": {"light": 3.47,  "dark": 8.16},  "minimum": 3.0}
    ]
  },
  "typography": {
    "families": {
      "heading": {"family": "Alexandria", "fallback": "system-ui, sans-serif", "use": "Wordmark and headings", "weights": {"display": 600, "h1": 600, "h2": 500, "h3": 500}},
      "body":    {"family": "Readex Pro", "fallback": "system-ui, sans-serif", "use": "Interface and body text", "weights": {"body": 400, "label": 500, "button": 500}}
    },
    "wordmark": {"family": "Alexandria", "weight": 600, "trackingPercent": -0.5, "outlined": true},
    "scale": {
      "display": {"family": "Alexandria", "weight": 600, "latin": {"size": 40, "lineHeight": 48}, "arabic": {"size": 40, "lineHeight": 60}},
      "h1":      {"family": "Alexandria", "weight": 600, "latin": {"size": 32, "lineHeight": 40}, "arabic": {"size": 32, "lineHeight": 48}},
      "h2":      {"family": "Alexandria", "weight": 500, "latin": {"size": 24, "lineHeight": 32}, "arabic": {"size": 24, "lineHeight": 36}},
      "h3":      {"family": "Alexandria", "weight": 500, "latin": {"size": 20, "lineHeight": 28}, "arabic": {"size": 20, "lineHeight": 32}},
      "body":    {"family": "Readex Pro", "weight": 400, "latin": {"size": 16, "lineHeight": 24}, "arabic": {"size": 16, "lineHeight": 28}},
      "small":   {"family": "Readex Pro", "weight": 400, "latin": {"size": 14, "lineHeight": 20}, "arabic": {"size": 14, "lineHeight": 24}},
      "caption": {"family": "Readex Pro", "weight": 400, "latin": {"size": 12, "lineHeight": 16}, "arabic": {"size": 12, "lineHeight": 20}}
    },
    "rules": {"fakeItalic": false, "allCapsLabels": false, "numerals": "Western (0-9) default, to be confirmed with pilot customers", "tabularFigures": true}
  },
  "spacing": {"baseGridPx": 8},
  "radius": {"controlPx": 8, "cardPanelPx": 12, "brandGraphicsPx": 0},
  "focusRing": {"widthPx": 2, "offsetPx": 2, "color": "primary"},
  "motion": {"durationMsMin": 150, "durationMsMax": 200, "easing": "ease-out", "purpose": "only to show a change of state", "reducedMotion": "respect reduced-motion settings (prefers-reduced-motion)"},
  "icons": {"set": "Lucide (ISC licence, UNVERIFIED)", "sizePx": 24, "strokePx": 1.75, "joins": "rounded", "style": "outline", "directionalIconsMirrorInRtl": true},
  "components": {
    "primaryButton": {"heightPx": 40, "radiusPx": 8, "fillLight": "primary", "labelLight": "#FFFFFF", "fillDark": "primary", "labelDark": "#0E1117", "font": "Readex Pro 500", "perView": 1},
    "secondaryButton": {"fill": "transparent", "label": "primary", "borderPrimaryOpacity": 0.40},
    "destructiveButton": {"fill": "danger", "label": "#FFFFFF", "requiresConfirmationNamingWhatIsDeleted": true},
    "statusPill": {"content": "icon and label in the status colour", "tintOpacity": 0.14, "success": "reported or paid", "warning": "attention", "danger": "rejected or failed", "colourNeverAlone": true},
    "amountsAndTables": {"figures": "tabular", "alignment": {"ltr": "right", "rtl": "left"}, "note": "aligned to the end of the column"},
    "assistantMessage": {"avatar": "mark in Cobalt, 20-24 px", "messageSurface": "surface"},
    "emptyStates": "say what to do next, in the brand voice",
    "errors": "name the problem and the fix, never apologise"
  },
  "logo": {
    "markHeightX": 1.4, "gapX": 0.6, "clearSpaceX": 1, "minLockupWidth": {"screenPx": 80, "printMm": 20}, "minMarkAlone": {"screenPx": 16, "printMm": 5},
    "twoToneMinMarkPx": 32, "handTunedSmallBelowPx": 24, "appIconMarkFraction": 0.56
  }
}
