# Local development configuration (ERP-001)
# Copy to .env and change credentials; NEVER commit .env to the repository.

# Pinned Version Set (G1 Spike: Frappe / ERPNext / HRMS v15)
# Frappe Framework: v15.126.0 (commit 53bae3ef2550ca96320f036f581446783cd11b72)
# ERPNext:          v15.124.5 (commit e5cde8c4b9e3f7f567a92ca3e65fd411402b89ce)
# Frappe HRMS:      v15.64.8  (commit 186900a6e3db4e6f927f1ee20df745bbb082638a)
# MariaDB:          10.6
# Redis:            7.2.7-alpine (BSD-3-Clause)
FRAPPE_VERSION=v15.126.0
ERPNEXT_VERSION=v15.124.5
HRMS_VERSION=v15.64.8
MARIADB_VERSION=10.6
REDIS_VERSION=7.2.7-alpine

# Database and Tenant Credentials
DB_ROOT_PASSWORD=change_me_root_secret
MYSQL_DATABASE=change_engine_dev
MYSQL_USER=ce_user
MYSQL_PASSWORD=change_me_user_secret

# Default Initial Site
SITE_NAME=dev.localhost
ADMIN_PASSWORD=change_me_admin_secret

# Exposed Host Ports (adjust if local ports are already in use)
DB_PORT=3306
REDIS_CACHE_PORT=12000
REDIS_QUEUE_PORT=11000
ENGINE_PORT=8000
