{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data of email events (contracts/connector-email.md section 12, contracts/events.md, ADR-0081 Proposed). No address, subject line, body, URL or provider diagnostic text: closed objects, opaque refs and bare 64-character hex hashes only.",
  "$defs": {
    "send_requested": {"type": "object", "additionalProperties": false, "properties": {"send_id": {"type": "string", "minLength": 1, "maxLength": 64}, "connection_ref": {"type": "string", "minLength": 1, "maxLength": 64}, "provider": {"enum": ["email.ses", "email.postmark", "email.sendgrid", "email.mailgun"]}, "purpose": {"enum": ["transactional", "marketing"]}, "mode": {"enum": ["single", "campaign_batch"]}, "country": {"enum": ["SA", "AE", "EG", "QA"]}, "contact_ref": {"type": "string", "minLength": 1, "maxLength": 64}, "batch_id": {"type": "string", "minLength": 1, "maxLength": 64}, "segment_ref": {"type": "string", "minLength": 1, "maxLength": 64}, "recipient_count": {"type": "integer", "minimum": 1}, "template_id": {"type": "string", "minLength": 1, "maxLength": 64}, "language": {"enum": ["ar", "en"]}, "notice_type": {"enum": ["invoice", "credit_note", "statement", "payment_receipt", "order_confirmation", "account_notice"]}, "document_id": {"type": "string", "minLength": 1, "maxLength": 64}, "consent_ref": {"type": "string", "minLength": 1, "maxLength": 64}, "origin": {"enum": ["human", "agent_draft"]}, "sent_by": {"type": "string", "minLength": 1, "maxLength": 64}, "drafted_by": {"type": "string", "minLength": 1, "maxLength": 64}, "confirmation_id": {"type": "string", "minLength": 1, "maxLength": 64}, "approval_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 64}, "payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "risk_class": {"const": "R3"}, "tracking_opens": {"type": "boolean"}, "tracking_clicks": {"type": "boolean"}, "sandbox": {"type": "boolean"}}, "required": ["send_id", "connection_ref", "provider", "purpose", "mode", "country", "template_id", "language", "origin", "sent_by", "confirmation_id", "payload_hash", "risk_class", "tracking_opens", "tracking_clicks", "sandbox"]},
    "delivery": {"type": "object", "additionalProperties": false, "properties": {"send_id": {"type": "string", "minLength": 1, "maxLength": 64}, "connection_ref": {"type": "string", "minLength": 1, "maxLength": 64}, "provider": {"enum": ["email.ses", "email.postmark", "email.sendgrid", "email.mailgun"]}, "contact_ref": {"type": "string", "minLength": 1, "maxLength": 64}, "provider_event_id": {"type": "string", "minLength": 1, "maxLength": 200}, "dedup_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "scheme": {"enum": ["sns_signature_v2", "basic_auth_ip_allowlist", "ecdsa_signed_timestamp", "hmac_sha256_timestamp_token", "one_click_token"]}}, "required": ["send_id", "connection_ref", "provider", "provider_event_id", "dedup_key", "scheme"]},
    "bounced": {"type": "object", "additionalProperties": false, "properties": {"send_id": {"type": "string", "minLength": 1, "maxLength": 64}, "connection_ref": {"type": "string", "minLength": 1, "maxLength": 64}, "provider": {"enum": ["email.ses", "email.postmark", "email.sendgrid", "email.mailgun"]}, "contact_ref": {"type": "string", "minLength": 1, "maxLength": 64}, "provider_event_id": {"type": "string", "minLength": 1, "maxLength": 200}, "dedup_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "scheme": {"enum": ["sns_signature_v2", "basic_auth_ip_allowlist", "ecdsa_signed_timestamp", "hmac_sha256_timestamp_token", "one_click_token"]}, "bounce_type": {"enum": ["hard", "soft"]}, "smtp_status": {"type": "string", "pattern": "^[245]\\.[0-9]{1,3}\\.[0-9]{1,3}$"}, "suppression_id": {"type": "string", "minLength": 1, "maxLength": 64}}, "required": ["send_id", "connection_ref", "provider", "provider_event_id", "dedup_key", "scheme", "bounce_type", "smtp_status"], "if": {"properties": {"bounce_type": {"const": "hard"}}}, "then": {"required": ["suppression_id"]}},
    "revoking": {"type": "object", "additionalProperties": false, "properties": {"send_id": {"type": "string", "minLength": 1, "maxLength": 64}, "connection_ref": {"type": "string", "minLength": 1, "maxLength": 64}, "provider": {"enum": ["email.ses", "email.postmark", "email.sendgrid", "email.mailgun"]}, "contact_ref": {"type": "string", "minLength": 1, "maxLength": 64}, "provider_event_id": {"type": "string", "minLength": 1, "maxLength": 200}, "dedup_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "scheme": {"enum": ["sns_signature_v2", "basic_auth_ip_allowlist", "ecdsa_signed_timestamp", "hmac_sha256_timestamp_token", "one_click_token"]}, "suppression_id": {"type": "string", "minLength": 1, "maxLength": 64}, "consent_revocation_ref": {"type": "string", "minLength": 1, "maxLength": 64}, "unsubscribe_source": {"enum": ["one_click_post", "body_link", "provider"]}}, "required": ["send_id", "connection_ref", "provider", "provider_event_id", "dedup_key", "scheme", "suppression_id", "consent_revocation_ref"]},
    "clicked": {"type": "object", "additionalProperties": false, "properties": {"send_id": {"type": "string", "minLength": 1, "maxLength": 64}, "connection_ref": {"type": "string", "minLength": 1, "maxLength": 64}, "provider": {"enum": ["email.ses", "email.postmark", "email.sendgrid", "email.mailgun"]}, "contact_ref": {"type": "string", "minLength": 1, "maxLength": 64}, "provider_event_id": {"type": "string", "minLength": 1, "maxLength": 200}, "dedup_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "scheme": {"enum": ["sns_signature_v2", "basic_auth_ip_allowlist", "ecdsa_signed_timestamp", "hmac_sha256_timestamp_token", "one_click_token"]}, "link_id": {"type": "string", "minLength": 1, "maxLength": 64}}, "required": ["send_id", "connection_ref", "provider", "provider_event_id", "dedup_key", "scheme", "link_id"]},
    "suppression": {"type": "object", "additionalProperties": false, "properties": {"suppression_id": {"type": "string", "minLength": 1, "maxLength": 64}, "supersedes": {"type": ["string", "null"], "minLength": 1, "maxLength": 64}, "contact_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 64}, "address_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "reason": {"enum": ["hard_bounce", "soft_bounce_repeated", "complaint", "unsubscribe", "manual"]}, "scope": {"enum": ["all", "marketing"]}, "source_event_id": {"type": "string", "minLength": 1, "maxLength": 64}, "lift_basis": {"enum": ["contact_opt_in", "address_reverified"]}, "lift_consent_ref": {"type": "string", "minLength": 1, "maxLength": 64}}, "required": ["suppression_id", "supersedes", "address_hash", "reason", "scope"]},
    "webhook_rejected": {"type": "object", "additionalProperties": false, "properties": {"provider": {"enum": ["email.ses", "email.postmark", "email.sendgrid", "email.mailgun"]}, "endpoint_id": {"type": "string", "pattern": "^whk_[A-Za-z0-9]{22,60}$"}, "scheme": {"enum": ["sns_signature_v2", "basic_auth_ip_allowlist", "ecdsa_signed_timestamp", "hmac_sha256_timestamp_token", "one_click_token"]}, "error_code": {"enum": ["EML-001", "EML-002", "EML-013"]}}, "required": ["provider", "endpoint_id", "error_code"]}
  }
}
