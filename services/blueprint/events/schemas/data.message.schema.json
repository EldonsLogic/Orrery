{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data of message and consent events (contracts/connector-messaging.md section 10, contracts/events.md, ADR-0078 Proposed). No message text, phone number or handle: closed objects.",
  "$defs": {
    "received": {"type": "object", "additionalProperties": false, "properties": {"message_id": {"type": "string", "minLength": 1, "maxLength": 64}, "conversation_id": {"type": "string", "minLength": 1, "maxLength": 64}, "channel": {"enum": ["whatsapp", "messenger", "sms"]}, "channel_account_ref": {"type": "string", "minLength": 1, "maxLength": 64}, "provider_event_id": {"type": "string", "minLength": 1, "maxLength": 128}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "verification": {"enum": ["meta_hmac_sha256", "provider_signature", "secret_path_ip_allowlist"]}, "flags": {"type": "array", "uniqueItems": true, "items": {"enum": ["instruction_like", "link", "opt_out_keyword", "bidi_override_stripped", "control_chars_stripped", "truncated"]}}, "tainted": {"const": true}}, "required": ["message_id", "conversation_id", "channel", "channel_account_ref", "provider_event_id", "content_hash", "verification", "flags", "tainted"]},
    "send_requested": {"type": "object", "additionalProperties": false, "properties": {"message_id": {"type": "string", "minLength": 1, "maxLength": 64}, "conversation_id": {"type": "string", "minLength": 1, "maxLength": 64}, "channel": {"enum": ["whatsapp", "messenger", "sms"]}, "channel_account_ref": {"type": "string", "minLength": 1, "maxLength": 64}, "country": {"enum": ["SA", "AE", "EG", "QA"]}, "mode": {"enum": ["session_reply", "template"]}, "template_id": {"type": "string", "minLength": 1, "maxLength": 64}, "category": {"enum": ["utility", "marketing"]}, "language": {"enum": ["ar", "en"]}, "origin": {"enum": ["human", "agent_draft", "auto_reply"]}, "sent_by": {"type": "string", "minLength": 1, "maxLength": 64}, "drafted_by": {"type": "string", "minLength": 1, "maxLength": 64}, "confirmation_id": {"type": "string", "minLength": 1, "maxLength": 64}, "payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "tainted": {"type": "boolean"}, "sandbox": {"type": "boolean"}, "risk_class": {"enum": ["R3", null]}, "consent_ref": {"type": "string", "minLength": 1, "maxLength": 64}, "approval_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 64}, "batch_id": {"type": "string", "minLength": 1, "maxLength": 64}, "inbound_message_id": {"type": "string", "minLength": 1, "maxLength": 64}, "auto_reply_policy_ref": {"type": "string", "minLength": 1, "maxLength": 64}, "approved_text_id": {"type": "string", "minLength": 1, "maxLength": 64}, "classified_intent": {"enum": ["greeting_ack", "opening_hours", "location", "handoff_ack"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "confidence_threshold": {"type": "number", "minimum": 0.8, "maximum": 1}}, "required": ["message_id", "channel", "channel_account_ref", "country", "mode", "origin", "payload_hash", "tainted", "sandbox", "risk_class"]},
    "status_changed": {"type": "object", "additionalProperties": false, "properties": {"message_id": {"type": "string", "minLength": 1, "maxLength": 64}, "channel": {"enum": ["whatsapp", "messenger", "sms"]}, "channel_account_ref": {"type": "string", "minLength": 1, "maxLength": 64}, "status": {"enum": ["accepted", "sent", "delivered", "read", "failed", "expired"]}, "error_code": {"type": "string", "pattern": "^MSG-[0-9]{3}$"}, "cost_micro_usd": {"type": ["integer", "null"], "minimum": 0}, "provider_event_id": {"type": "string", "minLength": 1, "maxLength": 128}, "dedup_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "required": ["message_id", "channel", "channel_account_ref", "status", "provider_event_id", "dedup_key"]},
    "consent_recorded": {"type": "object", "additionalProperties": false, "properties": {"consent_id": {"type": "string", "minLength": 1, "maxLength": 64}, "supersedes": {"type": ["string", "null"], "minLength": 1, "maxLength": 64}, "contact_ref": {"type": "string", "minLength": 1, "maxLength": 64}, "channel": {"enum": ["whatsapp", "messenger", "sms"]}, "country": {"enum": ["SA", "AE", "EG", "QA"]}, "purpose": {"enum": ["utility", "marketing"]}, "captured_by": {"enum": ["contact", "tenant_user", "provider"]}, "method": {"enum": ["web_form", "in_person", "chat_keyword", "sms_keyword", "phone"]}, "text_version": {"type": "string", "pattern": "^[a-z0-9_.-]{1,40}$"}, "source_message_id": {"type": "string", "minLength": 1, "maxLength": 64}}, "required": ["consent_id", "supersedes", "contact_ref", "channel", "country", "purpose", "captured_by", "method", "text_version"]},
    "consent_revoked": {"type": "object", "additionalProperties": false, "properties": {"consent_id": {"type": "string", "minLength": 1, "maxLength": 64}, "supersedes": {"type": ["string", "null"], "minLength": 1, "maxLength": 64}, "contact_ref": {"type": "string", "minLength": 1, "maxLength": 64}, "channel": {"enum": ["whatsapp", "messenger", "sms"]}, "country": {"enum": ["SA", "AE", "EG", "QA"]}, "purpose": {"enum": ["utility", "marketing"]}, "revoked_by": {"enum": ["contact_keyword", "contact_request", "tenant_user", "provider_block"]}, "source_message_id": {"type": "string", "minLength": 1, "maxLength": 64}}, "required": ["consent_id", "supersedes", "contact_ref", "channel", "country", "purpose", "revoked_by"]}
  }
}
