{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data of metering events",
  "$defs": {
    "ai_usage": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_micro_usd": {
          "type": "integer",
          "minimum": 0
        },
        "purpose": {
          "enum": [
            "chat",
            "agent",
            "build",
            "simulation"
          ]
        },
        "agent_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      },
      "required": [
        "model_id",
        "tier",
        "input_tokens",
        "output_tokens",
        "cached_tokens",
        "cost_micro_usd",
        "purpose"
      ]
    },
    "active_user": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "day": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "user_id",
        "day"
      ]
    },
    "storage": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "object",
          "properties": {
            "records": {
              "type": "integer",
              "minimum": 0
            },
            "files": {
              "type": "integer",
              "minimum": 0
            },
            "backups": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "records",
            "files",
            "backups"
          ]
        }
      },
      "required": [
        "bytes"
      ]
    },
    "documents_issued": {
      "type": "object",
      "properties": {
        "doc_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "doc_type",
        "count"
      ]
    },
    "connector_run": {
      "type": "object",
      "properties": {
        "connector_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "tier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "connector_id",
        "rows",
        "bytes",
        "tier"
      ]
    },
    "simulation_run": {
      "type": "object",
      "properties": {
        "records_replayed": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "records_replayed",
        "duration_ms"
      ]
    }
  }
}
