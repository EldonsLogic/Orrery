    "checkout_event": {
      "type": "object",
      "properties": {
        "payment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "checkout_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "entity",
              "id"
            ],
            "properties": {
              "entity": {
                "enum": [
                  "sales_invoice",
                  "sales_order",
                  "credit_note"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          }
        },
        "amount": {
          "type": "object",
          "required": [
            "minor",
            "currency"
          ],
          "properties": {
            "minor": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        },
        "provider": {
          "type": "string",
          "pattern": "^payments\\.[a-z0-9_]{2,32}$"
        },
        "environment": {
          "enum": [
            "sandbox",
            "live"
          ]
        },
        "gateway_payment_ref": {
          "type": "string",
          "pattern": "^[a-z0-9_]{2,32}:[A-Za-z0-9_.:-]{1,96}$"
        }
      },
      "required": [
        "payment_id",
        "checkout_id",
        "links",
        "amount",
        "provider",
        "environment"
      ]
    },
