      {"id": "submit_po_large", "from": "draft", "to": "pending_approval", "actionLabels": {"ar": "إرسال للاعتماد", "en": "Send for approval"}, "allowedRoles": ["purchasing_officer"], "guards": [{"field": "total_amount", "op": "gt", "value": 100000}], "notify": ["general_manager"]},
      {
