      {"id": "reject_po", "from": "pending_approval", "to": "draft", "actionLabels": {"ar": "إعادة للمسودة", "en": "Return to draft"}, "allowedRoles": ["general_manager", "owner"], "notify": ["purchasing_officer"]},
