      {"id": "cancel_po_draft", "from": "draft", "to": "cancelled", "actionLabels": {"ar": "إلغاء", "en": "Cancel"}, "allowedRoles": ["purchasing_officer"]},
      {"id": "cancel_po_ordered", "from": "ordered", "to": "cancelled", "actionLabels": {"ar": "إلغاء الأمر", "en": "Cancel order"}, "allowedRoles": ["general_manager", "owner"], "notify": ["purchasing_officer"]}
    ],
    "provenance": {"source": "template", "ref": "trading_distribution@0.1.0", "humanEdited": false}
  },
