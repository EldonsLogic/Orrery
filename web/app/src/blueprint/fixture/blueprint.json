 "workflows": [
  {
   "id": "sales_order_flow",
   "entity": "sales_order",
   "labels": {
    "ar": "مسار أمر البيع",
    "en": "Sales order flow"
   },
   "states": [
    {
     "id": "draft",
     "kind": "initial",
     "labels": {
      "ar": "مسودة",
      "en": "Draft"
     }
    },
    {
     "id": "pending_approval",
     "kind": "normal",
     "locksEditing": true,
     "labels": {
      "ar": "بانتظار الاعتماد",
      "en": "Pending approval"
     }
    },
    {
     "id": "approved",
     "kind": "normal",
     "locksEditing": true,
     "labels": {
      "ar": "معتمد",
      "en": "Approved"
     }
    },
    {
     "id": "delivered",
     "kind": "final",
     "locksEditing": true,
     "labels": {
      "ar": "تم التسليم",
      "en": "Delivered"
     }
    },
    {
     "id": "cancelled",
     "kind": "final",
     "locksEditing": true,
     "labels": {
      "ar": "ملغى",
      "en": "Cancelled"
     }
    }
   ],
   "transitions": [
    {
     "id": "submit_small",
     "from": "draft",
     "to": "approved",
     "actionLabels": {
      "ar": "اعتماد",
      "en": "Confirm"
     },
     "allowedRoles": [
      "sales_rep",
      "owner"
     ],
     "guards": [
      {
       "field": "total_amount",
       "op": "lt",
       "value": 50000
      }
     ]
    },
    {
     "id": "submit_large",
     "from": "draft",
     "to": "pending_approval",
     "actionLabels": {
      "ar": "إرسال للاعتماد",
      "en": "Send for approval"
     },
     "allowedRoles": [
      "sales_rep",
      "owner"
     ],
     "guards": [
      {
       "field": "total_amount",
       "op": "gte",
       "value": 50000
      }
     ],
     "notify": [
      "owner"
     ]
    },
    {
     "id": "approve_large",
     "from": "pending_approval",
     "to": "approved",
     "actionLabels": {
      "ar": "اعتماد",
      "en": "Approve"
     },
     "allowedRoles": [
      "owner"
     ],
     "approval": "large_order_approval"
    },
    {
     "id": "deliver",
     "from": "approved",
     "to": "delivered",
     "actionLabels": {
      "ar": "تأكيد التسليم",
      "en": "Confirm delivery"
     },
     "allowedRoles": [
      "warehouse_keeper",
      "owner"
     ]
    },
    {
     "id": "cancel_draft",
     "from": "draft",
     "to": "cancelled",
     "actionLabels": {
      "ar": "إلغاء",
      "en": "Cancel"
     },
     "allowedRoles": [
      "sales_rep",
      "owner"
     ]
    }
   ]
  }
 ],
