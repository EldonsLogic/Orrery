 "approvals": [
  {
   "id": "large_order_approval",
   "labels": {
    "ar": "اعتماد الطلبات الكبيرة",
    "en": "Large order approval"
   },
   "appliesTo": {
    "entity": "sales_order",
    "action": "submit"
   },
   "conditions": [
    {
     "field": "total_amount",
     "op": "gte",
     "value": 50000
    }
   ],
   "steps": [
    {
     "order": 1,
     "approverRole": "owner",
     "mode": "any_one",
     "timeoutHours": 48
    }
   ],
   "selfApproval": false
  }
