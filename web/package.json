{
  "name": "web",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=20.9.0" },
  "scripts": {
    "tokens": "node scripts/copy-tokens.mjs",
    "lint": "node scripts/copy-tokens.mjs && eslint . && node scripts/check-tokens-only.mjs && node scripts/check-rtl-css.mjs && node scripts/check-css-vars.mjs && node scripts/check-contrast.mjs",
    "check:tokens": "node scripts/check-tokens-only.mjs",
    "check:rtl": "node scripts/check-rtl-css.mjs",
    "typecheck": "pnpm tokens && pnpm -r typecheck",
    "test": "node --test scripts/ && vitest run",
    "build": "pnpm tokens && pnpm -r build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12"
  }
}
